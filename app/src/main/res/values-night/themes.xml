<resources>
    <!-- Night theme for Theme.MsgClientAndroid -->
    <style name="Theme.MsgClientAndroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="isLightTheme">false</item>
        <!-- Primary colors -->
        <item name="colorPrimary">@color/lavender_mist</item>
        <item name="colorOnPrimary">@color/deep_purple</item>
        <item name="colorPrimaryContainer">@color/deep_purple</item>
        <item name="colorOnPrimaryContainer">@color/lavender_mist</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/deep_purple</item>
        <item name="colorSecondaryContainer">@color/lavender_mist</item>
        <item name="colorOnSecondaryContainer">@color/deep_purple</item>

        <!-- Background colors -->
        <item name="android:windowBackground">#04052E</item>
        <item name="colorSurface">#04052E</item>
        <item name="colorSurfaceVariant">@color/lavender_mist</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/white</item>

        <!-- Dialog colors -->
        <item name="colorSurfaceContainer">#1A1B46</item>
        <item name="colorSurfaceContainerHigh">#1A1B46</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/lavender_mist</item>
        <item name="android:textColorHint">@color/lavender_mist</item>

        <!-- Button colors -->
        <item name="colorPrimaryInverse">@color/deep_purple</item>
    </style>
</resources>