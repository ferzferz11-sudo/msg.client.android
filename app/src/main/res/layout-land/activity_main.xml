<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="?android:attr/windowBackground"
    android:padding="32dp">

    <!-- Left side: Logo and info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingEnd="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/app_logo"
            android:scaleType="fitCenter"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/lavender_messenger" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lavender_messenger"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_description"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/appVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_version"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

    <!-- Right side: Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/updateAvailableIndicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_update_available"
                android:visibility="gone"
                android:contentDescription="@string/update_available"
                android:layout_marginEnd="4dp"
                app:tint="?attr/colorPrimary" />

            <Button
                android:id="@+id/downloadUpdateButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_update"
                style="@style/PrimaryButtonCompact" />

            <ImageButton
                android:id="@+id/copyLinkButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_copy"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <ImageButton
                android:id="@+id/shareLinkButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_share"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="?attr/colorPrimary"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/share_app" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/downloadProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/downloadProgressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/joinChatButton"
            style="@style/PrimaryButtonCompact"
            android:layout_marginBottom="16dp"
            android:text="@string/join" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/circle_indicator"
                android:backgroundTint="?attr/colorSecondary"
                android:layout_marginEnd="6dp" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/circle_indicator"
                android:backgroundTint="?attr/colorSecondary"
                android:layout_marginEnd="6dp" />

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/circle_indicator"
                android:backgroundTint="?attr/colorSecondary" />

        </LinearLayout>

        <Button
            android:id="@+id/languageButton"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:text="@string/toggle_language"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSecondary"
            android:backgroundTint="?attr/colorSecondary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/colorSchemeButton"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:text="@string/toggle_color_scheme"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSecondary"
            android:backgroundTint="?attr/colorSecondary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:text="@string/exit"
            android:textSize="14sp"
            android:textColor="?attr/colorOnPrimary"
            android:backgroundTint="?attr/colorPrimary" />

    </LinearLayout>

</LinearLayout>
