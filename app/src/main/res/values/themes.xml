<resources>
    <attr name="isLightTheme" format="boolean" />

    <!-- Light theme -->
    <style name="Theme.MsgClientAndroid" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="actionOverflowButtonStyle">@style/CustomOverflowStyle</item>
        <item name="isLightTheme">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Primary colors -->
        <item name="colorPrimary">@color/deep_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/lavender_mist</item>
        <item name="colorOnPrimaryContainer">@color/deep_purple</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/lavender_mist</item>
        <item name="colorOnSecondary">@color/deep_purple</item>
        <item name="colorSecondaryContainer">@color/soft_lilac</item>
        <item name="colorOnSecondaryContainer">@color/deep_purple</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/pale_lilac</item>
        <item name="colorSurface">@color/pale_lilac</item>
        <item name="colorSurfaceVariant">@color/white</item>
        <item name="colorOnSurface">@color/deep_purple</item>
        <item name="colorOnSurfaceVariant">@color/deep_purple</item>

        <!-- Dialog colors -->
        <item name="colorSurfaceContainer">@color/white</item>
        <item name="colorSurfaceContainerHigh">@color/white</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/deep_purple</item>
        <item name="android:textColorSecondary">@color/deep_purple</item>
        <item name="android:textColorHint">@color/lavender_mist</item>

        <!-- Button colors -->
        <item name="colorPrimaryInverse">@color/white</item>
    </style>

    <style name="Theme_Lavender_NoActionBar" parent="Theme.MsgClientAndroid" />

    <!-- Dark theme for manual switching -->
    <style name="Theme_Lavender_Dark_NoActionBar" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="actionOverflowButtonStyle">@style/CustomOverflowStyle</item>
        <item name="isLightTheme">false</item>
        <!-- Primary colors -->
        <item name="colorPrimary">@color/lavender_mist</item>
        <item name="colorOnPrimary">@color/deep_purple</item>
        <item name="colorPrimaryContainer">@color/deep_purple</item>
        <item name="colorOnPrimaryContainer">@color/lavender_mist</item>

        <!-- Secondary colors -->
        <item name="colorSecondary">@color/white</item>
        <item name="colorOnSecondary">@color/deep_purple</item>
        <item name="colorSecondaryContainer">@color/deep_purple</item>
        <item name="colorOnSecondaryContainer">@color/lavender_mist</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_background</item>
        <item name="colorSurfaceVariant">@color/deep_purple</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="colorOnSurfaceVariant">@color/lavender_mist</item>

        <!-- Dialog and Card colors -->
        <item name="colorSurfaceContainer">@color/deep_purple</item>
        <item name="colorSurfaceContainerHigh">@color/deep_purple</item>

        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/lavender_mist</item>
        <item name="android:textColorHint">@color/lavender_mist</item>

        <!-- Button colors -->
        <item name="colorPrimaryInverse">@color/deep_purple</item>
    </style>

    <style name="CustomOverflowStyle" parent="Widget.AppCompat.ActionButton.Overflow">
        <item name="android:src">@drawable/ic_overflow_settings</item>
        <item name="android:tint">?attr/colorOnPrimary</item>
    </style>
</resources>