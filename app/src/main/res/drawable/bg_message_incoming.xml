<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Используем светлый фон для входящих сообщений -->
    <solid android:color="@color/incoming_message_light" />
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp"
        android:bottomRightRadius="16dp"
        android:bottomLeftRadius="4dp" />
    <!-- Добавляем тонкую обводку, чтобы сообщение не сливалось с фоновым рисунком -->
    <stroke
        android:width="1dp"
        android:color="#20000000" />
    <padding
        android:left="12dp"
        android:top="8dp"
        android:right="12dp"
        android:bottom="8dp" />
</shape>