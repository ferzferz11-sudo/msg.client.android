<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/item_chat_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/participantAvatars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp" />

        <!-- Selection checkbox — visible only in selection mode -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbChatSelect"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            android:clickable="false"
            android:focusable="false"
            app:buttonTint="?attr/colorPrimary"
            android:contentDescription="@string/selected_count" />

        <LinearLayout
            android:id="@+id/llChatInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">

            <TextView
                android:id="@+id/tvChatName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="Chat Name"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvChatType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:text="General"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <ImageView
            android:id="@+id/ivMuteIndicator"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:src="@drawable/ic_volume_off"
            app:tint="?attr/colorOnSurfaceVariant"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="@string/muted_label"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <!-- Admin settings moved to toolbar -->
        <ImageView
            android:id="@+id/ivAdminIndicator"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="@string/muted_label"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvUnreadCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:paddingHorizontal="6dp"
            android:background="@drawable/unread_count_background"
            android:gravity="center"
            tools:text="1"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/btnEnterLobby"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:src="@drawable/ic_groups_2"
            android:background="@drawable/circle_button"
            android:backgroundTint="?attr/colorPrimary"
            app:tint="?attr/colorOnPrimary"
            android:visibility="gone"
            tools:visibility="visible"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/conference" />

        <ProgressBar
            android:id="@+id/pbDeleteChat"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="@null" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
