<?xml version="1.0" encoding="utf-8"?>
<!-- 
  widget_chat.xml — универсальный chat widget layout.
  Используется в NewChatActivity (групповой чат) и HermesChatActivity (агенты как участники).
  
  Структура:
    - Toolbar: аватар, название, статус/участники, действия
    - Messages: RecyclerView с адаптером
    - Reply preview: цитируемое сообщение
    - Input panel: emoji, input, attach, send
    - Typing indicator: встроен в адаптер (последний item)
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Background image -->
    <ImageView
        android:id="@+id/chatBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/custom_toolbar_height"
        android:background="@drawable/toolbar_background"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:navigationIconTint="?attr/colorOnPrimary"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical">

            <!-- Main toolbar content -->
            <LinearLayout
                android:id="@+id/toolbarContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:paddingEnd="8dp">

                <!-- Avatar / Icon -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/toolbarAvatar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_default_avatar"
                    android:visibility="gone"
                    app:civ_border_width="1.5dp"
                    app:civ_border_color="?attr/colorOnPrimary"
                    tools:visibility="visible" />

                <!-- Agent icon (emoji) for Hermes -->
                <TextView
                    android:id="@+id/toolbarAgentIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:background="@drawable/bg_hermes_circle"
                    android:visibility="gone"
                    tools:text="🎼"
                    tools:visibility="visible" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/toolbarTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="Chat Title" />

                    <!-- Group participants row -->
                    <LinearLayout
                        android:id="@+id/groupHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <LinearLayout
                            android:id="@+id/groupParticipantsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/toolbarSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnPrimary"
                            android:textSize="11sp"
                            android:alpha="1.0"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="1dp"
                            android:background="@drawable/bg_status_bubble"
                            android:visibility="gone"
                            tools:text="online"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/messagesRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/mentionContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_chat_message" />

    <!-- Mention popup — shows agent list when @ is typed -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mentionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:layout_constraintBottom_toTopOf="@id/replyPreview"
        app:layout_constrainedHeight="true"
        app:layout_constraintHeight_max="200dp"
        tools:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/mentionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp"
            tools:listitem="@layout/item_mention_agent" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Reply preview -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/replyPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <View
                android:id="@+id/replyBar"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="?attr/colorPrimary"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/replyUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="Pavel" />

                <TextView
                    android:id="@+id/replyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Hello, how are you?" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/cancelReply"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom input panel -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/attachButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/attach_file_add_24"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/attach_file_label"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/emojiButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/add_reaction_24"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/add_emoji" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/type_message_here"
                android:background="@android:color/transparent"
                android:padding="12dp"
                android:minLines="1"
                android:maxLines="12"
                android:gravity="top|start"
                android:scrollbars="vertical"
                android:textSize="16sp"
                android:inputType="textCapSentences|textMultiLine"
                android:autofillHints="none"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant" />

            <ImageButton
                android:id="@+id/audioButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_mic"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="@string/record_voice"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/sendButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/send_24"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@string/send_message" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
