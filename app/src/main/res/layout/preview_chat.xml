<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/previewChatRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <ImageView
        android:id="@+id/previewChatBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:id="@+id/previewChatToolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back_arrow"
            android:id="@+id/previewChatBack"
            app:tint="?attr/colorOnPrimary" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/previewChatAvatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:src="@drawable/ic_default_avatar" />

        <TextView
            android:id="@+id/previewChatTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Pavel Davydov"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/previewBottomPanel"
        android:layout_below="@id/previewChatToolbar"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Incoming -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/previewIncomingBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer">
            <TextView
                android:id="@+id/previewIncomingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Hi there! Check this theme preview."
                android:textColor="?android:attr/textColorPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Outgoing -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/previewOutgoingBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="12dp"
            android:maxWidth="200dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="?attr/colorPrimary">
            <TextView
                android:id="@+id/previewOutgoingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="Looks great! Love the background image support."
                android:textColor="?attr/colorOnPrimary" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/previewBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="?attr/colorSurface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:padding="4dp">

            <ImageView
                android:id="@+id/previewEmojiButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/add_reaction_24" />

            <TextView
                android:id="@+id/previewInputPlaceholder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="12dp"
                android:text="@string/type_message_here"
                android:textSize="16sp"
                android:alpha="0.6" />

            <ImageView
                android:id="@+id/previewAttachButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/attach_file_add_24" />

            <ImageView
                android:id="@+id/previewAudioButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_mic" />

            <ImageView
                android:id="@+id/previewSendButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/send_24" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
