<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="false">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/custom_toolbar_height"
        android:background="@drawable/toolbar_background"
        android:elevation="0dp"
        app:navigationIcon="@drawable/ic_back_arrow"
        app:navigationIconTint="?attr/colorOnPrimary"
        app:titleTextColor="?attr/colorOnPrimary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/black">

        <lavender.client.android.ui.sticker.StickerEditorView
            android:id="@+id/editorView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/textInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/etTextInput"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text_rounded"
                android:hint="@string/sticker_editor_enter_text"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@android:color/white"
                android:textColorHint="@color/text_hint"
                android:textSize="16sp"
                android:singleLine="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddText"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="@string/sticker_editor_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/colorPickerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivColorWhite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="4dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#FFFFFF"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/ivColorBlack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="4dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#000000"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/ivColorRed"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="4dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#FF0000"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/ivColorYellow"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="4dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#FFD700"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/ivColorGreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="4dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#4CAF50"
                android:padding="4dp" />

            <ImageView
                android:id="@+id/ivColorBlue"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_margin="4dp"
                android:background="@drawable/circle_shape"
                android:backgroundTint="#2196F3"
                android:padding="4dp" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/filterStrip"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:visibility="gone"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCrop"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:icon="@drawable/ic_crop_square"
            android:text="@string/sticker_editor_crop"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnText"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:icon="@drawable/ic_text_fields"
            android:text="@string/sticker_editor_text"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilters"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:icon="@drawable/ic_filter"
            android:text="@string/sticker_editor_filters"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
