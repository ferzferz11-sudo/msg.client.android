<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <ImageView
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:src="@drawable/ic_notification_logo"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true" />

    <TextView
        android:id="@+id/aboutLogoVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0.6.29"
        android:textSize="12sp"
        android:alpha="0.6"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/aboutAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lavender_messenger"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp"
        android:gravity="center">

        <TextView
            android:id="@+id/clientVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Client Version: --"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.8"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/serverVersionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server Version: --"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.8" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOnSurface"
        android:alpha="0.1"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/developerLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/developer_label"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurface"
        android:alpha="0.6"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/developerNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ferz (Pavel Davydov)"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="32dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/update_now"
        android:layout_marginBottom="12dp"
        app:cornerRadius="24dp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWhatsNew"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/whats_new"
        android:layout_marginBottom="12dp"
        app:cornerRadius="24dp"
        android:textColor="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFeedback"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/send_feedback"
        android:layout_marginBottom="12dp"
        app:cornerRadius="24dp"
        android:textColor="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnShare"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/share_with_friends"
        android:layout_marginBottom="12dp"
        app:cornerRadius="24dp"
        app:icon="@drawable/ic_share"
        app:iconGravity="textStart"
        android:textColor="?attr/colorPrimary"
        app:strokeColor="?attr/colorPrimary"
        app:iconTint="?attr/colorPrimary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/close"
        app:cornerRadius="24dp" />

</LinearLayout>
