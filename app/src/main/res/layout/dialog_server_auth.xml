<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@drawable/dialog_background">

    <!-- Logo -->
    <ImageView
        android:id="@+id/serverAuthLogo"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:src="@drawable/ic_notification_logo"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:clickable="true"
        android:focusable="true" />

    <!-- Server name -->
    <TextView
        android:id="@+id/serverAuthName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="4dp"
        tools:text="Lava (dev)" />

    <!-- Server address -->
    <TextView
        android:id="@+id/serverAuthAddress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:alpha="0.6"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="8dp"
        tools:text="13.140.25.249:50052" />

    <!-- Status row: indicator + version -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Online indicator (green/red circle) -->
        <View
            android:id="@+id/serverAuthStatusIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_indicator" />
    </LinearLayout>

    <!-- Divider -->
    <View style="@style/MenuDividerStyle" />

    <!-- Login button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServerLogin"
        style="@style/PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:textAllCaps="false"
        android:text="@string/login" />

    <!-- Register button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServerRegister"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:textAllCaps="false"
        android:text="@string/register"
        app:cornerRadius="28dp" />

    <!-- App version -->
    <TextView
        android:id="@+id/serverAuthAppVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:alpha="0.4"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="8dp"
        tools:text="Lava v1.1.3.11" />

</LinearLayout>
