<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@drawable/dialog_background">

    <!-- Drag handle -->
    <View
        android:id="@+id/dragHandle"
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorOnSurfaceVariant"
        android:alpha="0.3" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/serverAuthLogo"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:src="@drawable/ic_notification_logo"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:clickable="true"
        android:focusable="true" />

    <!-- Server info row: indicator + name + address -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Online indicator (green/red circle) -->
        <View
            android:id="@+id/serverAuthStatusIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_indicator"
            android:layout_marginEnd="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Server name -->
            <TextView
                android:id="@+id/serverAuthName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                tools:text="Lava Germany" />

            <!-- Server address -->
            <TextView
                android:id="@+id/serverAuthAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:alpha="0.6"
                android:textColor="?attr/colorOnSurface"
                tools:text="13.140.25.249:50051" />
        </LinearLayout>
    </LinearLayout>

    <!-- Login button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServerLogin"
        style="@style/PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:textAllCaps="false"
        android:text="@string/login" />

    <!-- Register button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnServerRegister"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:textAllCaps="false"
        android:text="@string/register"
        app:cornerRadius="28dp" />

    <!-- Update button (hidden by default, shown when update available) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUpdateApp"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:textAllCaps="false"
        android:text="@string/update_download_prompt"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- App version -->
    <TextView
        android:id="@+id/serverAuthAppVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:alpha="0.4"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginTop="8dp"
        tools:text="Lava v1.1.3.x"
            tools:ignore="SmallSp" />

</LinearLayout>
