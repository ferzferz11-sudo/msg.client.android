<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lavanda_messenger"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_version"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_description"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="48dp" />

    <Button
        android:id="@+id/joinChatButton"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:text="@string/join"
        android:textSize="18sp"
        android:backgroundTint="@color/lavender_mist"
        android:layout_marginBottom="48dp" />

    <View
        android:layout_width="240dp"
        android:layout_height="1dp"
        android:background="?android:attr/dividerHorizontal"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/languageButton"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:text="@string/toggle_language"
        android:textSize="14sp"
        android:backgroundTint="@color/deep_purple"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/colorSchemeButton"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:text="@string/toggle_color_scheme"
        android:textSize="14sp"
        android:backgroundTint="@color/soft_lilac"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/logoutButton"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:text="@string/exit"
        android:textSize="16sp"
        android:backgroundTint="@color/dark_slate"
        android:layout_marginBottom="12dp" />

</LinearLayout>
