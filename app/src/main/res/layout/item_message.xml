<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <!-- Date separator -->
    <TextView
        android:id="@+id/tvDateSeparator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:background="@drawable/bg_date_separator"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="22 мая" />

    <!-- Pinned message badge -->
    <LinearLayout
        android:id="@+id/llPinnedBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvDateSeparator"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pinned_badge"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/ivPinnedIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lock"
            android:contentDescription="@string/pinned_message"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:id="@+id/tvPinnedText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="13sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Pinned message" />

    </LinearLayout>

    <!-- Fixed selection indicator -->
    <ImageView
        android:id="@+id/ivSelectionIndicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignTop="@id/messageContainer"
        android:layout_alignBottom="@id/messageContainer"
        android:layout_alignParentStart="true"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_unchecked"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Message content that moves -->
    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_toEndOf="@id/ivSelectionIndicator"
        android:layout_below="@id/tvDateSeparator"
        android:layout_marginStart="0dp"
        android:gravity="bottom">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:scaleType="centerCrop"
            android:padding="1dp"
            android:layout_gravity="bottom"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="2dp"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/CircleAppearanceOverlay" />

        <LinearLayout
            android:id="@+id/messageBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:minWidth="40dp">

            <LinearLayout
                android:id="@+id/llReplyQuote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:background="@color/bg_reply_container"
                android:padding="4dp"
                android:layout_marginBottom="4dp">

                <View
                    android:id="@+id/vReplyBar"
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/lavender_mist"
                    android:layout_marginEnd="4dp" />

                <LinearLayout
                    android:id="@+id/llReplyContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvReplyUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/tg_blue" />

                    <TextView
                        android:id="@+id/tvReplyText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="?android:attr/textColorPrimary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="2dp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/flImageContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivMessageImage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="240dp"
                    android:minHeight="240dp"
                    android:maxWidth="300dp"
                    android:maxHeight="400dp"
                    android:adjustViewBounds="true"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="@string/app_name" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieStickerView"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:visibility="gone"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/ivStickerImage"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:visibility="gone"
                    android:scaleType="fitCenter"
                    android:clickable="true"
                    android:focusable="true"
                    android:adjustViewBounds="true" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGalleryThumbnails"
                    android:layout_width="wrap_content"
                    android:layout_height="64dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="2dp"
                    android:visibility="gone" />

            </FrameLayout>

            <lavender.client.android.ui.audio.AudioMessageView
                android:id="@+id/audioMessageView"
                android:layout_width="260dp"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/llMessageContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llMessageTextRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageButton
                        android:id="@+id/btnDownloadFile"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_download"
                        android:visibility="gone"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvMessageText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:autoLink="web"
                        android:linksClickable="true"
                        tools:text="Hello world" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llMessageMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tvEditedLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvMessageTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp" />

                    <ImageView
                        android:id="@+id/ivReadStatus"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="2dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:id="@+id/tvReactions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="4dp"
                android:textSize="12sp"
                android:background="@drawable/bg_reactions"
                android:visibility="gone"
                tools:visibility="visible"
                tools:text="❤️ 2" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
