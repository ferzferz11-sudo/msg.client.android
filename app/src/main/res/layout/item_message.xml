<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp"
    android:layout_marginVertical="4dp">

    <LinearLayout
        android:id="@+id/messageContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start"
        android:padding="0dp">

        <ImageView
            android:id="@+id/selectionIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_unchecked"
            android:visibility="gone"
            tools:visibility="visible" />

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/avatarImageView"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_default_avatar"
            android:layout_gravity="bottom"
            android:layout_marginEnd="8dp"
            android:visibility="gone"
            app:civ_border_width="0dp" />

        <LinearLayout
            android:id="@+id/messageBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:minWidth="60dp">

            <!-- Reply Quote View -->
            <LinearLayout
                android:id="@+id/replyQuoteContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:background="?attr/colorSurface"
                android:padding="4dp"
                android:layout_marginBottom="4dp">

                <View
                    android:layout_width="3dp"
                    android:layout_height="match_parent"
                    android:background="@color/lavender_mist"
                    android:layout_marginEnd="4dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/replyQuoteUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />

                    <TextView
                        android:id="@+id/replyQuoteText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="11sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="?android:attr/textColorPrimary" />

                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/userText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Username"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginBottom="2dp"
                android:textColor="?android:attr/textColorPrimary" />

            <ImageView
                android:id="@+id/messageImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="320dp"
                android:maxHeight="480dp"
                android:layout_marginTop="4dp"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:adjustViewBounds="true"
                android:contentDescription="@string/attach_image" />

            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/messageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Message content"
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:layout_marginEnd="40dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_alignBottom="@id/messageText"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/timeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="12:34"
                        android:textSize="11sp"
                        android:alpha="0.6"
                        android:textColor="?android:attr/textColorSecondary" />

                    <ImageView
                        android:id="@+id/readStatusIcon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_message_sent"
                        android:visibility="gone"
                        app:tint="?android:attr/textColorSecondary" />
                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/reactionsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:visibility="gone"
                android:textColor="?android:attr/textColorSecondary" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/deleteButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            android:contentDescription="@string/delete_message"
            android:visibility="gone"
            android:scaleType="centerInside"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>
