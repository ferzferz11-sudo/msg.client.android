<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurfaceContainer">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="?attr/colorOnSurfaceVariant" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/menuUserAvatar"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_default_avatar"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/menuUserAvatar"
            android:layout_toStartOf="@+id/actionShareHeader"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/menuUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/menuUserBio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone"
                android:maxLines="2"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionShareHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_share"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:text="@string/share_with_friends"
                android:textSize="10sp"
                android:textColor="?attr/colorPrimary"
                android:gravity="center"
                android:maxLines="2" />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?android:attr/dividerVertical"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:id="@+id/actionEditProfile"
        style="@style/MenuActionItemStyle">
        <ImageView
            style="@style/MenuActionIconStyle"
            android:src="@drawable/ic_edit" />
        <TextView
            style="@style/MenuActionTextStyle"
            android:text="@string/edit" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionThemes"
        style="@style/MenuActionItemStyle">
        <ImageView
            style="@style/MenuActionIconStyle"
            android:src="@drawable/ic_settings_brightness" />
        <TextView
            style="@style/MenuActionTextStyle"
            android:text="@string/themes" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionContacts"
        style="@style/MenuActionItemStyle">
        <ImageView
            style="@style/MenuActionIconStyle"
            android:src="@drawable/ic_contacts" />
        <TextView
            style="@style/MenuActionTextStyle"
            android:text="@string/contacts" />
    </LinearLayout>

    <View style="@style/MenuDividerStyle" />

    <LinearLayout
        android:id="@+id/actionNotifications"
        style="@style/MenuActionItemStyle">
        <ImageView
            style="@style/MenuActionIconStyle"
            android:src="@drawable/ic_notification_history" />
        <TextView
            style="@style/MenuActionTextStyle"
            android:text="@string/notifications" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionToggleLanguage"
        style="@style/MenuActionItemStyle">
        <ImageView
            style="@style/MenuActionIconStyle"
            android:src="@drawable/ic_language" />
        <TextView
            style="@style/MenuActionTextStyle"
            android:text="@string/toggle_language" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionUpdate"
        style="@style/MenuActionItemStyle">
        <ImageView
            style="@style/MenuActionIconStyle"
            android:src="@drawable/deployed_code_update_24" />
        <TextView
            style="@style/MenuActionTextStyle"
            android:text="@string/action_update" />
    </LinearLayout>

    <View style="@style/MenuDividerStyle" />

    <LinearLayout
        android:id="@+id/actionAbout"
        style="@style/MenuActionItemStyle">
        <ImageView
            style="@style/MenuActionIconStyle"
            android:src="@android:drawable/ic_dialog_info" />
        <TextView
            style="@style/MenuActionTextStyle"
            android:text="@string/action_about" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actionAdmin"
        style="@style/MenuActionItemStyle"
        android:visibility="gone">
        <ImageView
            style="@style/MenuActionIconStyle"
            android:src="@android:drawable/ic_lock_lock" />
        <TextView
            style="@style/MenuActionTextStyle"
            android:text="@string/action_super_admin" />
    </LinearLayout>

    <View style="@style/MenuDividerStyle" />

    <LinearLayout
        android:id="@+id/actionLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/exit_to_app_24"
            app:tint="#FF5252" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/logout_profile"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FF5252" />
    </LinearLayout>

</LinearLayout>